NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Required for public invoice pages and the daily billing cron.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# Public invoice links in emails (your deployed admin URL, no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3017

# Brevo transactional email (https://app.brevo.com)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=VonWillingh Online

# PayFast online payments. Leave the merchant id or key empty to hide Pay now.
# PAYFAST_MODE is sandbox or live. Anything else, including a blank value, means sandbox.
# For local sandbox tests only, PayFast publishes this test merchant (do not use it live):
#   PAYFAST_MERCHANT_ID=10000100
#   PAYFAST_MERCHANT_KEY=46f0cd694581a
#   PAYFAST_PASSPHRASE=jt7NOE43FZPn
# Never commit real merchant credentials.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
