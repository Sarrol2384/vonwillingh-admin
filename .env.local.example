NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for automated daily contract billing (cron)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# Public invoice links in emails (your deployed admin URL, no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3017

# Brevo transactional email (https://app.brevo.com)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=VonWillingh Online
